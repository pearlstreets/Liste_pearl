# OTP v2 — Firebase Web SDK config for Liste_Pearl (Expo managed)
# Uses the SAME Firebase project (pearl-streets-c3b29) as Websites +
# Mobile apps. Liste is registered as an Android native app in the
# Firebase project ("Pearl Streets Shoppi..." / com.pearlstreets.list),
# but since Expo Managed workflow can't use @react-native-firebase/*,
# we use the firebase Web SDK with the project's apiKey.
#
# Note: Firebase Web SDK requires reCAPTCHA. expo-firebase-recaptcha is
# archived. Firebase path in useOtpSender currently falls back to legacy
# until a replacement is wired. Twilio and WhatsApp providers still work
# server-side.
#
# To activate: merge these lines into Liste_Pearl/.env (Expo loads
# EXPO_PUBLIC_* at build time).

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBNX-JpzLLFebDpRFg132WjV2LMlq5VuL0
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=pearl-streets-c3b29.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=pearl-streets-c3b29
EXPO_PUBLIC_FIREBASE_APP_ID=1:413430640595:android:2a0b33caefe2adf1594926
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=413430640595
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=pearl-streets-c3b29.firebasestorage.app
