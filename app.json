{
  "expo": {
    "name": "Pearl List",
    "slug": "pearl-list",
    "scheme": "pearl-list",
    "version": "1.0.10",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3DBE4A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pearlstreets.list",
      "buildNumber": "1023",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Pearl List utilise l'appareil photo pour photographier votre liste de courses manuscrite ou un produit, par exemple prendre en photo un ticket de caisse pour ajouter les articles à votre liste.",
        "NSPhotoLibraryUsageDescription": "Pearl List accède à vos photos pour importer une image depuis votre galerie, par exemple une photo de votre liste de courses ou d'un produit à ajouter à votre liste, ou une photo de profil.",
        "NSLocationWhenInUseUsageDescription": "Pearl List utilise votre position pour afficher les magasins proches et estimer les frais de livraison, par exemple trouver les enseignes qui livrent à votre adresse.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.pearlstreets.list",
      "versionCode": 15,
      "allowBackup": false,
      "config": {
        "googleMaps": {
          "apiKey": "REMPLACE_PAR_TA_CLE_GOOGLE_MAPS_ANDROID"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3DBE4A"
      },
      "permissions": [
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "stripePublishableKey": "pk_live_51R8hqCArfIzMjUBjIDVUlchS37nktlFM2cdugW3ocvqBwdi8GxPuKkaKTlnGdX2Qb0yVbAK9JivZlUOAvgygP8Pe00JEBclh24",
      "eas": {
        "projectId": "c2ae23d8-1884-47ae-b45c-feea16814db6"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-location",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "./plugins/withSecuriteReseau"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c2ae23d8-1884-47ae-b45c-feea16814db6"
    },
    "owner": "localidad",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
