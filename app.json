{
  "expo": {
    "name": "Pearl List",
    "slug": "pearl-list",
    "scheme": "pearl-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pearlstreets.list",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette app utilise la caméra pour scanner votre liste de courses.",
        "NSPhotoLibraryUsageDescription": "Cette app accède à votre galerie pour importer une photo.",
        "NSLocationWhenInUseUsageDescription": "Pour trouver les magasins proches et optimiser la livraison.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "pythonapi.digiexports.in": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.pearlstreets.list",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "usesCleartextTraffic": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "pearlBaseUrl": "https://pythonapi.digiexports.in/api/v1",
      "oneSignalAppId": "31f08293-ee05-4113-8868-f4ce3bd14104",
      "eas": {
        "projectId": "c2ae23d8-1884-47ae-b45c-feea16814db6"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-location",
      "expo-secure-store",
      ["onesignal-expo-plugin", { "mode": "production", "disableNSE": true }]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "owner": "localidad"
  }
}
