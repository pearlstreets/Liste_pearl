  { id:'o1', name:"Huîtres n°3 Marennes", detail:"La douzaine", price:10.90, unitPrice:"", thumb:null, available:true },
];

const norm = (s) => String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
